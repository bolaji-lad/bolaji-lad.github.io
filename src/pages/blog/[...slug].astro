---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPosts } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const words = (post.body ?? '').split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 230));
---
<Base title={post.data.title} description={post.data.description} type="article">
  <article>
    <header class="post-head">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        {post.data.updated && <span>Updated {fmt(post.data.updated)}</span>}
        <span>{minutes} min read</span>
        {post.data.draft && <span>Draft</span>}
      </div>
    </header>
    <div class="prose"><Content /></div>
    {post.data.tags.length > 0 && <ul class="tags">{post.data.tags.map((t) => <li>{t}</li>)}</ul>}
  </article>
  <a class="back" href="/blog/">← All writing</a>
</Base>
